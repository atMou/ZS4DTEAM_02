@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Brand Time Analytics'
@Metadata.allowExtensions: true
@Metadata.ignorePropagatedAnnotations: false
@OData.applySupportedForAggregation: #FULL

define root view entity Z02_C_BRAND_TIME_ANALYTICS
  as projection on Z02_I_BRAND_TIME_ANALYTICS
{
  key BrandId,
  key CalendarYear,
  key CalendarQuarter,
  key YearMonth,
  key Currency,

      BrandName,

      @Aggregation.default: #SUM
      @Semantics.amount.currencyCode: 'Currency'
      TotalGrossSales,

      @Aggregation.default: #SUM
      @Semantics.amount.currencyCode: 'Currency'
      TotalNetSales,

      @Aggregation.default: #SUM
      @Semantics.amount.currencyCode: 'Currency'
      TotalCancelledValue,

      @Aggregation.default: #SUM
      TotalItems,

      @Aggregation.default: #SUM
      CancelledItems,

      @Aggregation.default: #SUM
      ActiveItems
}
