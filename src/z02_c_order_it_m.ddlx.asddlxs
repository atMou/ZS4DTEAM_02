  @Search.defaultSearchElement: true

  @UI.lineItem: [
      {
          position: 40,
          label: 'Produk',
          importance: #LOW
      }
  ]

  @UI.fieldGroup: [
      {
          qualifier: 'ProductData',
          position: 30,
          label: 'Produkt'
      }
  ]

