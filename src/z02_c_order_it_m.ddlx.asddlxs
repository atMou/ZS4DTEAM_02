@Metadata.layer: #CORE

@UI.headerInfo: {
    typeName: 'Auftragsposition',
    typeNamePlural: 'Auftragspositionen',

    title: {
        type: #STANDARD,
        value: 'ProductName'
    },

    description: {
        type: #STANDARD,
        value: 'OrderItemId'
    }
}

annotate entity z02_c_order_it_m with
{



  @UI.facet: [

      {
          id: 'ItemInformation',
          purpose: #STANDARD,
          type: #FIELDGROUP_REFERENCE,
          targetQualifier: 'ItemData',
          position: 10,
          label: 'Positionsinformationen'
      },

      {
          id: 'ProductInformation',
          purpose: #STANDARD,
          type: #FIELDGROUP_REFERENCE,
          targetQualifier: 'ProductData',
          position: 20,
          label: 'Produkt'
      },

      {
          id: 'TechnicalInformation',
          purpose: #STANDARD,
          type: #FIELDGROUP_REFERENCE,
          targetQualifier: 'Technical',
          position: 90,
          label: 'Technische Informationen'
      }

  ]




  @Search.defaultSearchElement: true

  @UI.lineItem: [
      {
          position: 10,
          label: 'Position',
          importance: #HIGH
      }
  ]

  @UI.fieldGroup: [
      {
          qualifier: 'ItemData',
          position: 10,
          label: 'Positionsnummer'
      }
  ]

