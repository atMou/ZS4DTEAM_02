  @UI.hidden: true
  ProductName;

  @Search.defaultSearchElement: true

  @UI.lineItem: [
      {
          position: 30,
          label: 'Marke',
          importance: #HIGH
      }
  ]

  @UI.fieldGroup: [
      {
          qualifier: 'ProductData',
          position: 20,
          label: 'Marke'
      }
  ]

