projection;
strict ( 2 );
use draft;

define behavior for z02_c_order_m alias Order
{
  use create;
  use update;
  use delete;

  use action nextStatus;
  use action cancelOrder;
  use action openAnalytics;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _order_item { create; with draft; }
}

define behavior for z02_c_order_it_m alias OrderItem
{
  use update;
  use delete;

  use association _Order { with draft; }
}