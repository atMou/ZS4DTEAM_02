@Metadata.layer: #CORE

@UI.chart: [ { qualifier: 'TopCustomers',
               title: 'Top 20 Customers',
               description: 'Top 20 customers by total net sales',
               chartType: #BAR,
               dimensions: [ 'CustomerId' ],
               measures: [ 'TotalNetSales' ],
               dimensionAttributes: [ { dimension: 'CustomerId', role: #CATEGORY } ],
               measureAttributes: [ { measure: 'TotalNetSales', role: #AXIS_1 } ] } ]

@UI.presentationVariant: [ { qualifier: 'Top20CustomersPV',
                             maxItems: 20,
                             sortOrder: [ { by: 'TotalNetSales', direction: #DESC } ],
                             visualizations: [ { type: #AS_CHART, qualifier: 'TopCustomers' } ] } ]

@UI.selectionPresentationVariant: [ { qualifier: 'Top20Customers',
                                      text: 'Top 20 Customers',
                                      selectionVariantQualifier: '',
                                      presentationVariantQualifier: 'Top20CustomersPV' } ]

annotate entity Z02_C_TOP_CUSTOMER_ANALYTICS with

{
  @EndUserText.label: 'Customer'
  @UI.textArrangement: #TEXT_FIRST
  CustomerId;

  @UI.hidden: true
  CustomerName;

  @UI.hidden: true
  Currency;

  @EndUserText.label: 'Net Sales'
  TotalNetSales;

  @EndUserText.label: 'Gross Sales'
  TotalGrossSales;

  @EndUserText.label: 'Cancelled Value'
  totalcancelledvalue;

  @EndUserText.label: 'Items'
  totalitems;

  @UI.hidden: true
  cancelleditems;

  @UI.hidden: true
  activeitems;
}